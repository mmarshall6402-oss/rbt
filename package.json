{
  "name": "fieldtrack",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "dev:api": "pnpm --filter @fieldtrack/api dev",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://fieldtrack:fieldtrack@localhost:5432/fieldtrack_test} pnpm test",
    "dev:web": "pnpm --filter @fieldtrack/web dev",
    "build": "pnpm --filter @fieldtrack/web build",
    "db:migrate": "pnpm --filter @fieldtrack/api migrate"
  }
}
